apiVersion: v1
kind: Config
clusters:
- name: policy
  cluster:
    server: https://127.0.0.1:9443/check
    certificate-authority: /etc/kubernetes/image-policy/ca.crt
users:
- name: apiserver
  user:
    client-certificate: /etc/kubernetes/image-policy/client.crt
    client-key: /etc/kubernetes/image-policy/client.key
contexts:
- name: policy
  context: {cluster: policy, user: apiserver}
current-context: policy
